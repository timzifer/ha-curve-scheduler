{
  "name": "zeitprofil-card",
  "version": "0.1.0",
  "private": true,
  "description": "Lovelace card for the Zeitprofil Home Assistant integration",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "demo:build": "esbuild demo/demo.ts --bundle --format=esm --outfile=demo/demo.js",
    "demo": "npm run demo:build && python3 -m http.server 8765",
    "screenshots": "node demo/screenshots.cjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "happy-dom": "^21.0.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "lit": "^3.3.3"
  }
}
